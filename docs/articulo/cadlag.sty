% ---------------- títulos
\titleformat{\part}[display]{\filcenter\sffamily}
  {\vspace*{\fill}\small\bfseries\color{cdpurple}\MakeUppercase{\partname}~\thepart}
  {1.4em}{\Huge\bfseries\color{cdink}}[\vspace{0.6em}{\color{cdrule}\titlerule[1pt]}\vspace*{\fill}]
\titleformat{\chapter}[display]{\sffamily}
  {\small\bfseries\color{cdpurple}\MakeUppercase{\chaptertitlename}~\thechapter}
  {1.1em}{\Huge\bfseries\color{cdink}}[\vspace{0.5em}{\color{cdrule}\titlerule[0.9pt]}]
\titleformat{name=\chapter,numberless}[display]{\sffamily}{}{0pt}{\Huge\bfseries\color{cdink}}[\vspace{0.5em}{\color{cdrule}\titlerule[0.9pt]}]
\titlespacing*{\chapter}{0pt}{2.5cm}{1.6cm}
\titleformat{\section}{\sffamily\Large\bfseries\color{cdink}}{\color{cdpurple}\thesection}{0.6em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{cdink}}{\color{cdpurple}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}[runin]{\normalfont\bfseries\color{cdink}}{}{0pt}{}[.]
\titlespacing*{\section}{0pt}{1.9em}{0.9em}
\titlespacing*{\subsection}{0pt}{1.4em}{0.6em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.6em}
\newcommand{\parrafo}[1]{\par\smallskip\noindent\textbf{#1}\quad}

% ---------------- índice
\titlecontents{part}[0pt]{\addvspace{1.6em}\large\bfseries\color{cdblue}}
  {\contentslabel[\thecontentslabel]{2em}}{}{\hfill\contentspage}[\addvspace{0.4em}]
\titlecontents{chapter}[0pt]{\addvspace{1.0em}\bfseries\color{cdblue}}
  {\contentslabel[\thecontentslabel]{1.8em}}{}{\hfill\contentspage}[\addvspace{0.2em}]
\titlecontents{section}[1.8em]{\color{cdblue}}
  {\contentslabel{2.2em}}{}{\titlerule*[0.75em]{.}\contentspage}
\titlecontents{subsection}[4em]{\color{cdblue}}
  {\contentslabel{2.8em}}{}{\titlerule*[0.75em]{.}\contentspage}
\setcounter{tocdepth}{1}

% ---------------- encabezados
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\small\color{cdgray}càdlàg}
\fancyhead[R]{\sffamily\small\color{cdgray}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\color{cdgray}\thepage}
\renewcommand{\headrule}{{\color{cdlight}\hrule height 0.4pt}}
\renewcommand{\chaptermark}[1]{\markboth{\ifnum\value{chapter}>0 \chaptertitlename\ \thechapter. \fi #1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\color{cdgray}\thepage}\renewcommand{\headrule}{}}

% ---------------- teoremas
\newtheoremstyle{cd}{0.8em}{0.8em}{\itshape}{}{\sffamily\bfseries\color{cdblue}}{.}{0.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ {\mdseries\color{cdblue!80}(#3)}}}
\newtheoremstyle{cdrm}{0.8em}{0.8em}{\normalfont}{}{\sffamily\bfseries\color{cdblue}}{.}{0.5em}
  {\thmname{#1}\thmnumber{ #2}\thmnote{ {\mdseries\color{cdblue!80}(#3)}}}
\theoremstyle{cd}
\newtheorem{teorema}{Teorema}[chapter]
\newtheorem{proposicion}[teorema]{Proposición}
\newtheorem{lema}[teorema]{Lema}
\newtheorem{corolario}[teorema]{Corolario}
\theoremstyle{cdrm}
\newtheorem{definicion}[teorema]{Definición}
\newtheorem{observacion}[teorema]{Observación}
\newtheorem{ejemplo}[teorema]{Ejemplo}
\renewcommand{\qedsymbol}{\textcolor{cdpurple}{\rule{0.62em}{0.62em}}}
\renewenvironment{proof}[1][Demostración]{\par\pushQED{\qed}\normalfont\topsep0.5em\trivlist
  \item[\hskip\labelsep\itshape #1.]\ignorespaces}{\popQED\endtrivlist\@endpefalse}

% ---------------- cajas
\newtcolorbox{nota}[1]{enhanced,breakable,colback=cdboxbg,colframe=cdpurple,boxrule=0pt,
  leftrule=3.5pt,arc=0pt,outer arc=0pt,left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=1.2em,after skip=1em,
  attach boxed title to top left={yshift=0pt,xshift=0pt},
  boxed title style={colback=cdboxbg,boxrule=0pt,arc=0pt,left=8pt,right=8pt,top=2pt,bottom=1pt},
  coltitle=cdpurple,fonttitle=\sffamily\bfseries\small,title={#1}}
\newtcolorbox{conclusion}[1][]{enhanced,colback=cdbluebg,colframe=cdblue,boxrule=0pt,
  leftrule=3.5pt,arc=0pt,outer arc=0pt,left=10pt,right=10pt,top=7pt,bottom=7pt,
  before skip=1.2em,after skip=1em}
\newtcolorbox{comandos}{enhanced,breakable,colback=cdboxbg,colframe=cdpurple,boxrule=0pt,
  leftrule=3.5pt,arc=0pt,outer arc=0pt,left=10pt,right=10pt,top=4pt,bottom=4pt,
  attach boxed title to top left={yshift=0pt,xshift=0pt},
  boxed title style={colback=cdboxbg,boxrule=0pt,arc=0pt,left=8pt,right=8pt,top=2pt,bottom=1pt},
  coltitle=cdpurple,fonttitle=\sffamily\bfseries\small,title={Comandos},fontupper=\ttfamily\small}

